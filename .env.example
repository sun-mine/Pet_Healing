# ===== 后端（FastAPI）=====
APP_NAME=Pet Healing
APP_ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8000

# 允许跨域的前端地址，多个用英文逗号分隔
CORS_ORIGINS=http://localhost:5173

# 数据库连接串（不填则默认使用 backend/data/app.db 的 SQLite）
# 例如 PostgreSQL：DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/pet_healing
# DATABASE_URL=

# ===== 前端（Vite，仅 VITE_ 前缀会暴露给浏览器）=====
VITE_API_BASE_URL=/api
